# Sentry Configuration
# Replace with your actual Sentry DSN from https://sentry.io
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENV=production

# Headless Mode (set to true to run browser in background)
HEADLESS=false

# Microsoft Authentication
# Add your Microsoft/Office365 credentials for automated login
MS_EMAIL=your.email@example.com
MS_PASSWORD=your_password_here

# Miner Configuration
POLL_INTERVAL=5
PAGE_LOAD_DELAY_MIN=5.0
PAGE_LOAD_DELAY_MAX=8.0

# ============================================
# NOTIFICATION SETTINGS (Optional)
# Configure one or both for push notifications
# ============================================

# Discord Webhook
# 1. Go to Discord Server -> Settings -> Integrations -> Webhooks
# 2. Create webhook and copy URL
DISCORD_WEBHOOK_URL=

# Telegram Bot
# 1. Message @BotFather on Telegram -> /newbot -> follow steps
# 2. Copy the bot token
# 3. Start a chat with your bot
# 4. Get chat ID from: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
